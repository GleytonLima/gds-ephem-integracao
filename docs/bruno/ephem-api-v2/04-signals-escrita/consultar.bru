meta {
  name: Consultar pelo external_id
  type: http
  seq: 3
}

get {
  url: {{baseUrl}}/signals/{{externalId}}
  body: none
  auth: inherit
}

script:post-response {
  const data = (res.getBody() || {}).data || {};
  if (data.updated_at) bru.setVar("updatedAt", data.updated_at);
}

tests {
  test("200 com geo e source", function() {
    expect(res.getStatus()).to.equal(200);
    const data = res.getBody().data;
    expect(data.id).to.equal(bru.getVar("signalId"));
    expect(data.geo.country).to.include(bru.getEnvVar("country"));
  });
}
